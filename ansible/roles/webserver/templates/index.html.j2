<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ app_name }} — {{ environment | upper }}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #0f0f0f;
      color: #e0e0e0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .card {
      background: #1a1a2e;
      border: 1px solid #333;
      border-radius: 12px;
      padding: 40px;
      max-width: 600px;
      width: 90%;
      text-align: center;
    }
    .badge {
      display: inline-block;
      background: #00d4aa;
      color: #000;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 20px;
    }
    h1 { font-size: 2rem; margin-bottom: 10px; }
    .subtitle { color: #888; margin-bottom: 30px; font-size: 0.95rem; }
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      text-align: left;
    }
    .info-item {
      background: #0f0f1a;
      border-radius: 8px;
      padding: 12px 16px;
    }
    .info-item .label {
      font-size: 0.7rem;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .info-item .value {
      font-size: 1rem;
      color: #00d4aa;
      font-weight: 600;
      margin-top: 4px;
    }
    .footer {
      margin-top: 30px;
      font-size: 0.8rem;
      color: #555;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="badge">{{ environment }}</div>
    <h1>🚀 {{ app_name }}</h1>
    <p class="subtitle">Provisioned by Terraform · Configured by Ansible</p>

    <div class="info-grid">
      <div class="info-item">
        <div class="label">Server</div>
        <div class="value">{{ inventory_hostname }}</div>
      </div>
      <div class="info-item">
        <div class="label">IP Address</div>
        <div class="value">{{ ansible_host }}</div>
      </div>
      <div class="info-item">
        <div class="label">Version</div>
        <div class="value">{{ app_version }}</div>
      </div>
      <div class="info-item">
        <div class="label">Deployed At</div>
        <div class="value">{{ ansible_date_time.date }}</div>
      </div>
    </div>

    <div class="footer">
      Infrastructure as Code Lab · DevOps Track
    </div>
  </div>
</body>
</html>
